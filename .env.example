# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Google AI Studio: Automatically injected at runtime from user secrets.
# On Vercel: Add this in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=""

# Optional Supported Aliases on Vercel:
# GOOGLE_GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Automatically set or defaults to current origin.
APP_URL=""

# Campusly Secure Admin Authentication (Vercel Production)
# Set these in your Vercel Project Settings > Environment Variables
ADMIN_EMAIL="admin@campusly.internal"
ADMIN_PASSWORD="AdminMaster2026!"

# Supabase Backend Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_PROJECT_ID=""

# Secret used to sign HMAC-SHA256 session authentication tokens
AUTH_SECRET="campusly_master_production_secret_key_2026"


