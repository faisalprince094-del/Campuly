# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Google AI Studio: Automatically injected at runtime from user secrets.
# On Vercel: Add this in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=""

# Optional Supported Aliases on Vercel:
# GOOGLE_GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Automatically set or defaults to current origin.
APP_URL=""

